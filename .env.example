# Copy to .env and adjust. Every variable is optional; the defaults run the demo with the offline model.
# Keys stay out of the repository: put them in .env (gitignored) or your secret manager.

# ---------------------------------------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------------------------------------
# fake (offline, rule-based), openrouter (free models by default), compat (any OpenAI-compatible endpoint)
RECUT_LLM_PROVIDER=fake
# Empty = the provider's default (openrouter: nvidia/nemotron-3-super-120b-a12b:free).
RECUT_LLM_MODEL=
RECUT_LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
# Refuse any OpenRouter model id that does not end in ":free", paid plugins and answers served by paid models.
RECUT_REQUIRE_FREE_MODELS=true
# The explicit opt-in for paid models on openrouter and compat (off: every non-":free" model id is refused).
RECUT_ALLOW_PAID_MODELS=false
# The compat provider: an OpenAI-compatible /chat/completions endpoint and its key.
RECUT_LLM_BASE_URL=
RECUT_LLM_API_KEY=
OPENROUTER_API_KEY=
# Disk cache, call ledger (model ids, status, tokens, latency; never prompts) and a hard ceiling on real calls.
RECUT_LLM_CACHE=true
RECUT_LLM_LEDGER=results/calls.jsonl
RECUT_LLM_MAX_CALLS=1500
RECUT_LLM_MIN_SECONDS_BETWEEN_REQUESTS=3.2

# ---------------------------------------------------------------------------------------------------------
# Speech recognition (local, CPU)
# ---------------------------------------------------------------------------------------------------------
# whisper (faster-whisper) or sidecar (read <file>.words.json next to the media)
RECUT_ASR=whisper
RECUT_WHISPER_MODEL=small
RECUT_WHISPER_COMPUTE_TYPE=int8
RECUT_WHISPER_LANGUAGE=en
RECUT_DIARIZE=true

# ---------------------------------------------------------------------------------------------------------
# Clips and rendering
# ---------------------------------------------------------------------------------------------------------
RECUT_CLIP_MIN_SECONDS=20
RECUT_CLIP_MAX_SECONDS=60
RECUT_CLIPS_PER_10_MINUTES=3
RECUT_RENDER_WIDTH=1080
RECUT_RENDER_HEIGHT=1920
RECUT_RENDER_PRESET=veryfast
RECUT_RENDER_CRF=21
RECUT_LOUDNORM=true

# ---------------------------------------------------------------------------------------------------------
# Storage and API
# ---------------------------------------------------------------------------------------------------------
RECUT_DATA_DIR=data/projects
# Extra local folders the API and the MCP server may import from (comma-separated).
RECUT_ALLOWED_SOURCE_DIRS=
RECUT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
